# 应用标题，首页头部直接读取
NEXT_PUBLIC_APP_NAME=医共体管理平台

# 首页头部天气文案
NEXT_PUBLIC_WEATHER_TEXT=晴
NEXT_PUBLIC_WEATHER_TEMPERATURE=24°C

# 聚合接口服务地址
# 服务端未单独配置时，会自动复用这个地址s
NEXT_PUBLIC_API_BASE_URL = 
# NEXT_PUBLIC_API_BASE_URL = http://121.40.242.155
# NEXT_PUBLIC_API_BASE_URL=https://anxu.dalian.in

# 当前联调用 token
# 服务端未单独配置时，会自动复用这个 token
NEXT_PUBLIC_API_ACCESS_TOKEN=
# NEXT_PUBLIC_API_ACCESS_TOKEN=IXJvQFTmqDDggvndhvfFwNhWgYCC3sMp07k99d3zjpZchPRaEhUwzGkD5nJ1JAKw

# 鉴权头改为：X-Api-Token: <token>
# NEXT_PUBLIC_API_AUTH_HEADER_NAME=X-Api-Token

# X-Api-Token 不需要 Bearer 前缀，所以这里留空
NEXT_PUBLIC_API_AUTH_SCHEME=
